APP_ENV=development
APP_DEBUG=true
APP_COOLDOWN=60
# Local development BASE_URL (active example):
BASE_URL=https://onderwijsformulier.test
# Acceptance (the active deployment remains environment-controlled):
# APP_ENV=production, APP_DEBUG=false,
# BASE_URL=https://onderwijsboeking.test.ignorelist.com
# Production after the controlled cutover:
# APP_ENV=production, APP_DEBUG=false,
# BASE_URL=https://onderwijsboeking.geofort.nl
# Keep the acceptance URL allowed while planner acceptance is still in progress.

# Asset server only; this is not an allowed BASE_URL.
VITE_DEV_SERVER_URL=https://onderwijsformulier.test:5241
VITE_BUILD_PATH=public/build

AUTH_SESSION_TIMEOUT_PRODUCTION=1800
AUTH_SESSION_TIMEOUT_DEVELOPMENT=3600
AUTH_REVALIDATION_SECONDS=900
AUTH_MAX_ADMINS=5
AUTH_SESSION_COOKIE_NAME=geofort_admin_session
AUTH_SESSION_COOKIE_SAMESITE=Lax
LOGIN_LOCKOUT_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_SECONDS=900
LOGIN_LOCKOUT_BASE_SECONDS=120
LOGIN_LOCKOUT_MAX_SECONDS=1800

DB_HOST=127.0.0.1
DB_NAME=geoform_db
DB_USER=root
DB_PASSWORD=
# Backwards-compatible application setting; keep equal to DB_PASSWORD.
DB_PASS=
DB_PORT=3306

# Read-only legacy source used only by scripts/migrate-legacy-bookings.php.
# It must not point to the same host/port/schema combination as DB_*.
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_NAME=school_db_legacy
LEGACY_DB_USER=legacy_readonly
LEGACY_DB_PASSWORD=
LEGACY_DB_PORT=3306
LEGACY_SOURCE_FILENAME=school-db-production-legacy.sql

# Optional when the default CLI is older than the project's PHP >= 8.1 requirement.
MIGRATION_PHP_BINARY=

MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_SMTP_DEBUG=0
MAIL_PLANNER_EMAIL_USER=onderwijs@geofort.nl
MAIL_PLANNER_EMAIL_PWD=
MAIL_FROM_EMAIL=onderwijs@geofort.nl
MAIL_FROM_NAME=GeoFort Onderwijs
MAIL_RECEIVER_DEVELOPMENT_EMAIL=geofort.testboeking@gmail.com
MAIL_CC_EMAILS=kevin@geofort.nl

VITE_DEV_ALLOWED_ORIGIN=https://onderwijsformulier.test
